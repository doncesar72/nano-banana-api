{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/img/(.*)", "dest": "/public/img/$1" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/app", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "env": {
    "KIE_API_KEY": "@kie_api_key",
    "ADMIN_SECRET": "@admin_secret",
    "CREDITS_PER_GEN": "12",
    "WELCOME_CREDITS": "12"
  }
}
