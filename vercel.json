{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/img/(.*)", "dest": "/public/img/$1" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/app", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
 
